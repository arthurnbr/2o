# Maintainer: Arthur Nobrega <arthur.nbga@gmail.com>
pkgname=2o-git
pkgver=0.1.0.r0.gf65d370
pkgrel=1
pkgdesc='Open files and URLs on your local desktop from a remote SSH shell'
arch=('x86_64' 'aarch64')
url='https://github.com/arthurnbr/2o'
license=('MIT')
depends=('openssh' 'xdg-utils')
makedepends=('git' 'go' 'make')
provides=('2o')
conflicts=('2o' '2o-bin')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')
# Static, stripped binaries: `2o ssh` uploads them to remote servers,
# including servers whose CPU differs from this machine's.
options=('!debug' '!strip')

pkgver() {
  cd "$pkgname"
  git describe --long --tags --match 'v*' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd "$pkgname"
  export GOFLAGS='-mod=readonly -modcacherw'
  make VERSION="$pkgver" all
}

check() {
  cd "$pkgname"
  go test ./...
}

package() {
  cd "$pkgname"
  # /usr/bin/2o for this machine, /usr/lib/2o/2o-linux-{amd64,arm64} for servers.
  # `install` rebuilds (Go cache hit): pass the same VERSION, or it stamps `git describe`.
  make VERSION="$pkgver" DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
